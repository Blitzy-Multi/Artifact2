# ============================================================================
# .gitignore — Python 3 / Flask application (Artifact2)
# ----------------------------------------------------------------------------
# Standard ignore patterns for a Python/Flask project. Local virtual
# environments, bytecode caches, packaging/build output, test & coverage
# artifacts, local environment files, the Flask instance folder, and OS/editor
# noise are ignored. Tracked project files (requirements.txt, pyproject.toml,
# .env.example, README.md, and all application source) are intentionally NOT
# ignored.
# ============================================================================

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.mypy_cache/
.ruff_cache/
.pytype/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/

# --- Test & coverage artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Environment files / secrets (keep the committed template) ---
.env
.env.*
!.env.example

# --- Flask runtime & misc ---
instance/
*.log

# --- IDE / editor / OS noise ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
