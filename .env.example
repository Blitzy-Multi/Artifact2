# =============================================================================
# Environment configuration template for the Artifact2 Flask application.
#
# Project: Node.js (Express) -> Python 3 / Flask port (see AAP Section 0.3).
#
# USAGE
#   cp .env.example .env
# then edit the values in the resulting `.env` to suit your environment.
#
# IMPORTANT
#   * `.env` is git-ignored (see .gitignore); this `.env.example` template IS
#     committed. NEVER place real secrets in this file -- it holds placeholders
#     and safe defaults only. Put real secret values only in your local `.env`.
#   * Values are loaded at startup by python-dotenv and read by the Config
#     class in `app/config.py`. Every ACTIVE variable below is part of the
#     application's configuration surface; its KEY NAME must stay in sync with
#     the attribute that `app/config.py` reads.
#   * Format is one `KEY=VALUE` per line; lines beginning with `#` are comments
#     and are ignored by python-dotenv.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Flask runtime (ACTIVE) -- universal, source-agnostic configuration.
# These apply to ANY Flask port and are safe to enable today, before the
# original Node.js source is supplied.
# -----------------------------------------------------------------------------

# Flask CLI application entrypoint. Points the `flask` command at the WSGI
# module that exposes the application object (`app = create_app()`).
# Read by `flask run`, `flask shell`, and other Flask CLI commands, AND mirrored
# into `app/config.py` as `Config.FLASK_APP` so this active key maps 1:1 onto the
# configuration surface (its key name stays in sync with the attribute the
# Config class reads).
FLASK_APP=wsgi.py

# Debug toggle: 0 = off (production-safe), 1 = on (interactive debugger +
# auto-reloader; NEVER enable in production). Read by the `flask run` dev server,
# AND consumed by `app/config.py`, which parses it into `Config.FLASK_DEBUG` and
# derives `Config.DEBUG` from it so the env var and Flask's app.config["DEBUG"]
# never disagree. When unset, each config profile applies its own default
# (development/testing on, production off); an explicit value here overrides it.
FLASK_DEBUG=0

# Selects which configuration class `app/config.py` activates
# (e.g. development / production / testing). Keep this KEY NAME identical to
# the selector that `app/config.py` reads; if that module uses a different
# name (such as CONFIG_TYPE), rename this key to match it.
APP_CONFIG=development

# Secret used to sign session cookies and other ItsDangerous tokens.
# PLACEHOLDER ONLY -- generate a strong random value for your local `.env`
# (for example: python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=change-me-in-your-local-env

# Network interface the server binds to. 0.0.0.0 listens on all interfaces
# (suitable for containers); use 127.0.0.1 to restrict to localhost only.
HOST=0.0.0.0

# TCP port the server listens on. The default 8000 is the conventional Python
# WSGI port (it matches gunicorn's own default bind) and is used as the
# source-agnostic scaffold default. Consumed by the development server and by
# the gunicorn bind address (for example: gunicorn -b $HOST:$PORT wsgi:app).
# Adjust to the original project's listening port once that source is known.
PORT=8000

# -----------------------------------------------------------------------------
# --- Populate from the original Node.js project's env usage (uncomment & set as needed) ---
#
# The original Node.js source is NOT yet present in this repository (AAP Section
# 0.1 "Critical Precondition"), so its exact `process.env.*` set is unknown.
# The entries below are the COMMON source-derived variables, kept COMMENTED and
# inert so python-dotenv ignores them. Once the original project is supplied,
# uncomment exactly the ones it actually used, set real values in your local
# `.env` (never here), and add the matching attribute to `app/config.py`.
# These mirror the conditional dependency tier in requirements.txt one-to-one.
# -----------------------------------------------------------------------------

# SQL database connection string -- if the original used Sequelize / Knex / pg /
# mysql2 (ported to SQLAlchemy). Example form: postgresql+psycopg://localhost:5432/mydb
# DATABASE_URL=

# MongoDB connection URI -- if the original used Mongoose / mongodb
# (ported to PyMongo). Example form: mongodb://localhost:27017/mydb
# MONGO_URI=

# Secret used to sign and verify JSON Web Tokens -- if the original used
# jsonwebtoken (ported to PyJWT). Set a strong random value in your `.env`.
# JWT_SECRET=

# JWT lifetime / expiration window -- if the original set a token TTL.
# Example: 3600 (seconds) or a duration string such as 1h.
# JWT_EXPIRES_IN=

# Allowed cross-origin origins for CORS -- if the original configured `cors`
# (ported to Flask-Cors). Comma-separated list of origins, or * for any origin.
# CORS_ORIGINS=

# Request rate-limit policy -- if the original used express-rate-limit
# (ported to Flask-Limiter). Example: 100 per minute.
# RATE_LIMIT=

# Application log verbosity -- maps to the original morgan / winston level.
# One of: debug | info | warning | error | critical.
# LOG_LEVEL=info
