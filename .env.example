# Environment configuration template for the Artifact2 Flask application.
#
# Usage:
#   cp .env.example .env
# Then edit values as needed. `.env` is git-ignored and must never contain
# committed secrets. Values are loaded at startup via python-dotenv.

# HTTP listening port.
# Mirrors the original Express server's `process.env.PORT` (default 3000).
# Consumed by the development server and by the gunicorn bind address.
PORT=3000
